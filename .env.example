# ==============================================================
# Conversational SQL Analytics Assistant - Environment Variables
# ==============================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Authentication & Security
# WARNING: In production (NODE_ENV=production), weak or default keys are strictly rejected at startup.
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_secure_random_jwt_refresh_secret_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Database Configuration (PostgreSQL with pgvector)
# For Host-based Local Development: PG_HOST=localhost
# For Docker Compose: PG_HOST=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conversational_sql
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_postgres_password
PG_DATABASE=conversational_sql
PG_SSL=false

# Optional Redis Cache (Not required for analytical or RAG operations)
REDIS_URL=redis://localhost:6379

# AI Service Settings
AI_PORT=8000
DEFAULT_LLM_PROVIDER=gemini # 'gemini' or 'openai'
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Query Safety Limits
MAX_EXECUTION_TIME_MS=30000
MAX_ROW_LIMIT=1000
AUTO_EXECUTE_SELECT=true
REQUIRE_CONFIRMATION_FOR_MUTATIONS=true

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
